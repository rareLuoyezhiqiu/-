{
  "name": "inspiration-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run build && npm run test:server && playwright test",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "test:server": "node --test server/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "vue": "^3.5.45"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
